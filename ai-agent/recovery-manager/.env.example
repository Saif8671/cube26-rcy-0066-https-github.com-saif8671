# ==============================================================================
# Recovery Manager - Environment Configuration Template
# Copy this file to .env and populate with appropriate environment values.
# ==============================================================================

# Database Connection (Targeting PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/[DATABASE]

# Supabase API Configuration
SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key

# AI Provider API Keys (For reasoning & extraction)
ANTHROPIC_API_KEY=sk-ant-api03-...
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Backend Service Configuration
BACKEND_PORT=8000
BACKEND_ENV=development
# Allowed CORS origins: Comma-separated list or '*' for local development
ALLOWED_ORIGINS=*

# Frontend Service Configuration
FRONTEND_PORT=3000
NODE_ENV=development
